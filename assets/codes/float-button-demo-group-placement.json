class=\"token punctuation\">></span></span>\n        @for (placement of placements; track placement) {\n          <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nz-float-button-group</span>\n            <span class=\"token attr-name\">[class]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>placement<span class=\"token punctuation\">\"</span></span>\n            <span class=\"token attr-name\">[nzIcon]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>icons[$index]<span class=\"token punctuation\">\"</span></span>\n            <span class=\"token attr-name\">nzType</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>primary<span class=\"token punctuation\">\"</span></span>\n            <span class=\"token attr-name\">nzTrigger</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>click<span class=\"token punctuation\">\"</span></span>\n            <span class=\"token attr-name\">[nzPlacement]</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span><span class=\"token punctuation\">\"</span>placement<span class=\"token punctuation\">\"</span></span>\n          <span class=\"token punctuation\">></span></span>\n            <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nz-float-button</span> <span class=\"token punctuation\">/></span></span>\n            <span class=\"token tag\"><span class=\"token tag\"><span class=\"token punctuation\">&lt;</span>nz-float-button</span> <span class=\"token attr-name\">nzIcon</span><span class=\"token attr-value\"><span class=\"token punctuation attr-equals\">=</span